# Copy to .env and fill in. Never commit .env — it is git-ignored.
# Anything without a VITE_ prefix stays on the server and never reaches the browser bundle.

# --- API ---
PORT=
NODE_ENV=
LOG_LEVEL=
WEB_ORIGIN=

# --- Supabase / database ---
# Supabase issues these as "publishable" and "secret"; they replace the older
# anon / service_role key pair. SUPABASE_SECRET_KEY bypasses Row Level Security,
# so it is server-only and must never gain a VITE_ prefix.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Required value: payslip-sources
STORAGE_BUCKET=

# Used by the Supabase CLI to push migrations, not by the API at runtime.
DATABASE_URL=

# --- Uploads ---
# Defaults: 10485760 bytes (10 MB) and 10 PDF pages.
MAX_UPLOAD_BYTES=
MAX_PDF_PAGES=

# --- Extraction (server-only) ---
# Must never gain a VITE_ prefix.
# Azure AI Foundry 'payslip-ocr-prototype' — Sweden Central
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=
AZURE_CONTENT_UNDERSTANDING_KEY=
# Names the analyzer family: extraction runs as two passes, `<id>_scalars` and `<id>_tables`.
AZURE_CU_ANALYZER_ID=
AZURE_CU_API_VERSION=
# Defaults: 120000 ms timeout per pass and 3 concurrent analyses; each payslip runs two.
EXTRACTION_TIMEOUT_MS=
EXTRACTION_CONCURRENCY=

# --- Client (browser) ---
# Only VITE_-prefixed variables reach the browser bundle. The publishable key is designed to be
# public: it is the successor to the anon key, it is what Row Level Security assumes the browser
# holds, and on its own it grants nothing — every request is still scoped by the user's own token.
# The secret key above must never gain this prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional. Only set this when the client and API are deployed as separate origins (no dev-proxy
# equivalent in production); leave blank for local dev and same-origin deployments.
VITE_API_BASE_URL=

# --- Bake-off harness (scripts/bakeoff) ---
# Server-only. Must never gain a VITE_ prefix.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Same resource, Azure OpenAI surface (challenger LLM)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
